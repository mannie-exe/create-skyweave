    {
      "path": "overrides/client/options.txt",
      "sha256": "d979ebecef834bf24926b89013881d2e1bf962e41c046d10da22c3d3a6834f24",
      "review": "reviewed",
      "reason": "Select Refined Tools/Torches/Buckets, the Create bucket addon and Luminous Lanterns, with Visual Patches last for current-base bucket bindings, the 1.21.1 flint-and-steel backport and the independent redstone torch. Retain Fluid & Foolish, Punched Backpacks and FA+Objects while mob Fresh Animations and Details stay deselected. Seed 12/10 distances and the existing input bindings; existing players retain seeded preferences.",
      "reference": "docs/players/graphics.md#resource-packs"
    },
    {
      "path": "overrides/common/config/DistantHorizons.toml",
      "sha256": "fec30458fb13e44f6c0e0b89b624965b70e8712a90d388ff543ee7c7918628b1",
      "review": "reviewed",
      "reason": "Bound multiplayer LOD transfers to 2048 KB/s, 64 fresh requests and 100 sync requests. Disable height-based cave culling for floating island undersides. Exclude glow lichen from LOD rendering because DH 3.3.3 transfers its tint and emissive material to columns below, including fluids; native lichen remains visible. Retain 256-chunk rendering, four workers, CHUNKS_ONLY generation and hidden progress; preserve installation-specific identities.",
      "reference": "docs/development/compatibility.md#dh-multiplayer-cache-filling",
      "installation": {
        "policy": "seed",
        "family": "host-settings"
      }
    },
