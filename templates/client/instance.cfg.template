[General]
ConfigVersion=1.2
InstanceType=OneSix
ExportAuthor={{ini_quote AUTHOR}}
; Deliberate pack memory override; otherwise Prism inherits launcher settings.
OverrideMemory=true
MaxMemAlloc=8192
MinMemAlloc=512
; Java 21 client default; players can override this in instance settings.
OverrideJavaArgs=true
JvmArgs=-XX:+UseZGC -XX:+ZGenerational
name={{ini_quote NAME}}
iconKey=create-skyweave
AutoUpdate=false
ManagedPack=true
OverrideCommands=true
PreLaunchCommand={{#if INSTANCE_PREPARE_COMMAND}}{{ini_quote INSTANCE_PREPARE_COMMAND}}{{/if}}
WrapperCommand={{#if INSTANCE_WRAPPER_COMMAND}}{{ini_quote INSTANCE_WRAPPER_COMMAND}}{{/if}}
