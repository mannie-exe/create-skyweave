{
  "name": "create-skyweave-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro check && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "verify": "pnpm lint && pnpm check:unused && pnpm test && pnpm build",
    "setup:python": "python3 -m venv .cache/python && .cache/python/bin/python -m pip install -r requirements.txt",
    "test:python": ".cache/python/bin/python -m unittest discover -s tests -p 'test_*.py'",
    "data:check": "node scripts/verify_snapshot.mjs",
    "media:collect": "node scripts/collect-resource-media.mjs",
    "data:runtime": "python3 scripts/runtime.py",
    "data:extract": "python3 scripts/extract.py",
    "data:world": ".cache/python/bin/python scripts/world.py",
    "data:compile": "node scripts/workspace-cli.mjs map.compile",
    "data:refresh": "pnpm data:runtime && pnpm data:extract && pnpm data:compile",
    "deploy:preview": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "format": "prettier --write . ../docs/development/web",
    "lint": "prettier --check . ../docs/development/web",
    "test:browser": "playwright test",
    "data:structures": "python3 scripts/structures.py",
    "data:islands": "python3 scripts/islands.py",
    "data:locales": "node scripts/minecraft-locales.mjs",
    "check:unused": "knip",
    "test:static": "playwright test --config playwright.static.config.ts"
  },
  "dependencies": {
    "@astrojs/react": "7.1.2",
    "@base-ui/react": "1.9.0",
    "@dnd-kit/react": "0.5.3",
    "@xyflow/react": "12.12.0",
    "astro": "7.4.4",
    "chokidar": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "ws": "8.22.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@types/ws": "8.18.2",
    "knip": "6.44.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "6.0.3",
    "wrangler": "4.156.0"
  }
}
