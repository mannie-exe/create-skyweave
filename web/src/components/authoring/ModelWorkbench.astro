---
import Field from '../ui/Field.astro'
import SourceEditor from '../ui/SourceEditor.astro'
import Button from '../ui/Button.astro'
import Workbench from '../ui/Workbench.astro'
import PreviewSurface from '../ui/PreviewSurface.astro'
import ResourcePreviewOptions from './ResourcePreviewOptions.astro'
---

<Workbench>
  <Fragment slot="browser">
    <Field id="model-search" label="Find model">
      <input id="model-search" type="search" />
    </Field>
    <div id="model-list" class="entry-list" aria-label="Model recipes"></div>
  </Fragment>
  <section id="model-editor" class="content-stack" hidden>
    <div class="control-row">
      <Field id="model-label" label="Label">
        <input id="model-label" />
      </Field>
      <label class="inline-field">
        <input id="model-enabled" type="checkbox" /> Include in generated pack
      </label>
    </div>
    <p id="model-output" class="model-path"></p>
    <ResourcePreviewOptions
      id="model-resource-preview"
      inputId="model-modpack"
    />
    <div
      id="model-related-textures"
      class="content-stack"
      data-space="control"
      hidden
    ></div>
    <fieldset id="extrusion-fields" hidden>
      <legend>Extrusion</legend>
      <div class="model-fields">
        <Field id="model-mask-kind" label="Select pixels by">
          <select id="model-mask-kind">
            <option value="alpha">Opacity</option>
            <option value="material">Material mask</option>
          </select>
        </Field>
        <Field id="model-depth" label="Depth">
          <input
            id="model-depth"
            type="number"
            min="0.125"
            max="4"
            step="0.125"
          />
        </Field>
        <Field id="model-threshold" label="Alpha threshold">
          <input id="model-threshold" type="number" min="1" max="255" />
        </Field>
        <Field id="model-plane" label="Plane">
          <select id="model-plane"></select>
        </Field>
        <Field id="model-axis" label="Axis">
          <select id="model-axis">
            <option>x</option>
            <option>y</option>
            <option>z</option>
          </select>
        </Field>
        <Field id="model-center" label="Center">
          <input id="model-center" type="number" step="0.125" />
        </Field>
      </div>
      <div id="model-span" class="model-fields"></div>
    </fieldset>
    <fieldset id="fitting-fields" hidden>
      <legend>Model fitting</legend>
      <div class="model-fields">
        <Field id="model-element" label="Element">
          <select id="model-element"></select>
        </Field>
        <Field id="model-face" label="Face">
          <select id="model-face"></select>
        </Field>
        <Field id="model-rotation" label="UV rotation">
          <select id="model-rotation">
            <option>0</option>
            <option>90</option>
            <option>180</option>
            <option>270</option>
          </select>
        </Field>
      </div>
      <div id="model-bounds" class="model-fields"></div>
      <Button intent="destructive" id="model-reset-element">
        Reset element
      </Button>
    </fieldset>
    <div class="model-previews" data-mask-layout="inspector">
      <section class="content-stack model-texture-panel">
        <header class="section-heading">
          <h2>Texture region</h2>
        </header>
        <div id="model-uv" class="model-fields"></div>
        <PreviewSurface
          id="texture-preview-surface"
          label="Updating texture preview"
        >
          <canvas
            id="model-texture"
            width="512"
            height="512"
            aria-label="Texture UV selection"
          ></canvas>
        </PreviewSurface>
        <p class="scope">
          Drag a region or enter UV coordinates. The texture view shows the
          first frame.
        </p>
      </section>
      <section class="content-stack model-geometry-panel">
        <div class="section-heading">
          <h2>Model</h2>
          <Button id="model-camera">Reset view</Button>
          <label class="inline-field">
            <input id="model-wire" type="checkbox" /> Wireframe
          </label>
        </div>
        <PreviewSurface
          id="model-preview-surface"
          label="Updating model preview"
        >
          <canvas
            id="model-canvas"
            aria-label="Interactive model preview"
          ></canvas>
        </PreviewSurface>
        <p id="model-statistics" class="scope"></p>
        <p class="scope">
          Drag to orbit; scroll to zoom. Game lighting, shaders, and moving
          contraptions require an in-game check.
        </p>
      </section>
      <aside class="model-tools content-stack" aria-label="Texture tools">
        <section id="texture-composition-tools" class="content-stack" hidden>
          <h2>Texture composition</h2>
          <p data-text-role="caption">
            Regions apply from top to bottom. UV bounds use 0–16; flips precede
            rotation.
          </p>
          <div id="texture-operations" class="content-stack"></div>
        </section>
        <fieldset id="material-mask-tools" class="content-stack" hidden>
          <legend>Material selection</legend>
          <Field id="mask-tool" label="Texture tool">
            <select id="mask-tool">
              <option value="pick">Sample color</option>
              <option value="region">Restrict region</option>
              <option value="include">Include pixels</option>
              <option value="exclude">Exclude pixels</option>
              <option value="crop">UV crop</option>
            </select>
          </Field>
          <Field id="mask-tolerance" label="Color tolerance">
            <input
              id="mask-tolerance"
              type="number"
              min="0"
              max="64"
              step="1"
            />
          </Field>
          <div class="content-stack" data-space="control">
            <h3 data-text-role="group-title">Sampled colors</h3>
            <div id="mask-palette" class="action-row"></div>
            <Button id="mask-clear-colors" intent="destructive">
              Clear colors
            </Button>
          </div>
          <div class="content-stack" data-space="control">
            <h3 data-text-role="group-title">Regions</h3>
            <div
              id="mask-regions"
              class="content-stack"
              data-space="control"
            ></div>
          </div>
          <Button id="mask-reset-corrections" intent="destructive">
            Reset pixel corrections
          </Button>
          <label class="inline-field">
            <input type="checkbox" id="mask-show-grid" checked /> Pixel grid
          </label>
          <label class="inline-field">
            <input type="checkbox" id="mask-show-overlay" checked /> Mask
            overlay
          </label>
          <p id="mask-status" role="status" data-text-role="caption"></p>
          <p data-text-role="caption">
            Arrow keys move between pixels. Enter uses the selected tool.
          </p>
        </fieldset>
      </aside>
    </div>
    <details class="disclosure">
      <summary>Recipe JSON</summary>
      <div class="content-stack">
        <SourceEditor
          id="model-json"
          label="Selected recipe"
          rows={18}
          aria-describedby="models-status"
        >
          <Fragment slot="actions">
            <Button id="model-apply-json">Apply to draft</Button>
            <Button intent="destructive" id="model-discard-json" disabled>
              Discard JSON edits
            </Button>
          </Fragment>
        </SourceEditor>
      </div>
    </details>
  </section>
</Workbench>
