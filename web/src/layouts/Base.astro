---
import '../styles/base.css'
import '../styles/activity.css'

interface Props {
  title: string
  activityDock?: boolean
}

const { title, activityDock = false } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot name="header" />
    <div
      class="workspace-layout"
      data-activity-host
      data-activity-dock-allowed={activityDock}
    >
      <div class="workspace-content">
        <slot />
      </div>
      <aside
        id="workspace-activity-dock"
        class="workspace-activity"
        hidden
      ></aside>
    </div>
  </body>
</html>
