---
import Button from '../components/ui/Button.astro'
import Field from '../components/ui/Field.astro'
import Base from '../layouts/Base.astro'
import AppHeader from '../components/AppHeader.astro'
import Candidate from '../components/resourcepacks/Candidate.astro'
import ReviewIndex from '../components/resourcepacks/ReviewIndex.astro'
import {
  catalog,
  pack,
  checkedSelections,
  enabledThirdParty,
  partialSources,
  ownedArtifacts,
  thirdParty,
  builtInSelections,
  projects,
  reviews,
  reviewedAt,
  stale,
  statuses,
  target,
} from '../lib/resourcepack-data'
import '../styles/resourcepacks.css'
import '../styles/resource-index.css'
import objectSources from '../../../authoring/resource-objects.json'
import { createRequire } from 'node:module'
import { configuredPack } from '../../scripts/configuration.mjs'
import { resolve } from 'node:path'
import type { ObjectCatalogue } from '../lib/object-resources'
// Keep host modules native: their tool guards use original source URLs.
const { publicProjectionJSON } = createRequire(resolve('package.json'))(
  './scripts/workspace/public-read.ts',
)
const categories = [...new Set(reviews.map((r) => r.category))].sort()
const objectCatalogue: ObjectCatalogue | undefined = await publicProjectionJSON(
  {
    scope: { workspaceId: 'local', packId: 'create_skyweave' },
    web: resolve('.'),
    pack: await configuredPack(resolve('.')),
  },
  'objects',
  'index.json',
)
function candidateLink(candidate: (typeof objectSources.candidates)[number]) {
  let object = candidate.objects[0],
    caseId = ''
  for (const id of candidate.objects) {
    const entry = objectCatalogue?.objects.find(
      (entry) => entry.registryId === id && entry.kind === 'block',
    )
    const variant = entry?.cases.find(
      (value) =>
        value.previews[candidate.id]?.supported &&
        value.previews.pack?.supported &&
        value.previews[candidate.id].digest !== value.previews.pack.digest,
    )
    if (variant) {
      object = id
      caseId = variant.id
      break
    }
  }
  const params = new URLSearchParams({
    object: 'block/' + object,
    a: 'pack',
    b: candidate.id,
    source: candidate.id,
  })
  if (caseId) params.set('case', caseId)
  return '/resource-authoring?' + params
}
---

<Base title="Resource packs · Create: Skyweave">
  <AppHeader slot="header" page="resources" />
  <main id="main-content" tabindex="-1" class="resource-review">
    <div class="review-toolbar">
      <h1 data-text-role="view-title">Resource packs</h1>
      <a class="ui-button" href="/resourcepacks/reviews">
        Compare captures
      </a>
      <Field id="pack-search" label="Search" layout="inline">
        <input
          id="pack-search"
          type="search"
          placeholder="Pack, feature or mod"
        />
      </Field>
      <Field id="pack-status" label="Decision" layout="inline">
        <select id="pack-status">
          <option value="">All decisions</option>
          {Object.entries(statuses).map(([id, label]) => (
            <option value={id}>{label}</option>
          ))}
        </select>
      </Field>
      <Field id="pack-category" label="Scope" layout="inline">
        <select id="pack-category">
          <option value="">All scopes</option>
          {categories.map((category) => (
            <option>{category}</option>
          ))}
        </select>
      </Field>
      <Button id="pack-reset" type="button">
        Reset
      </Button>
    </div>
    <div class="review-summary">
      <span id="pack-count" role="status" aria-live="polite">
        {reviews.length} project reviews
      </span>
      <span>
        {catalog.entries.length} ranked listings · Minecraft {target.minecraft}{' '}
        · inspected {reviewedAt}
      </span>
    </div>
    <p class="review-stack" data-text-role="caption">
      Create: Skyweave {pack.pack.version} · {enabledThirdParty} enabled packs ·{' '}
      {partialSources.size} sources with selected features · {ownedArtifacts}{' '}
      pack-owned artifacts. {checkedSelections}/{thirdParty.length} locked
      resource-pack files match the archived inspection. Defaults come from the
      modpack; personal client choices can differ.
    </p>
    <p>
      <a href="/resource-authoring?kind=entity&object=entity%2Fminecraft%3Acreeper&case=rest&a=native&b=pack">
        Compare mob models and textures
      </a>
    </p>
    <details class="disclosure">
      <summary>Object comparisons · selected and deferred</summary>
      <div class="content-stack">
        <p data-text-role="caption">
          Selected features are built into Create Skyweave Resource Patches.
          Full donor packs stay disabled. Compare the built result with upstream
          resources; deferred features remain available for review.
        </p>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>Source</th>
                <th>Review scope</th>
                <th>Comparison</th>
              </tr>
            </thead>
            <tbody>
              {objectSources.candidates.map((candidate) => (
                <tr>
                  <td>
                    <a href={candidate.url}>{candidate.label}</a>
                    <p data-text-role="caption">{candidate.version}</p>
                  </td>
                  <td>{candidate.note}</td>
                  <td>
                    <a href={candidateLink(candidate)}>Compare objects</a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </details>
    <details class="review-method">
      <summary>Coverage and limits</summary>
      <p>{catalog.method}</p>
      <p>
        Selection and default priority come from empack and the client options.
        Higher priority overrides lower entries. Resource-only mods load
        separately.
        {builtInSelections.length > 0 && (
          <>
            Additional enabled built-in packs:{' '}
            <code>{builtInSelections.join(', ')}</code>.
          </>
        )}
        {stale && (
          <>
            The complete lock differs from the inspection baseline; overlap
            counts remain the dated {target.pack} survey.
          </>
        )}
      </p>
      <p>
        Shortlisted files were inspected against Create: Skyweave {target.pack},
        resource format {target.resourceFormat} and the installed resources.
        Selection status is separate from that inspection baseline. “Try first”
        means a useful next playtest, not certified compatibility.
      </p>
      <p>
        Source galleries can show newer versions, shaders or optional
        extensions. Matching a few mod assets does not mean complete mod
        support. The priority is preserving vanilla materials, pixel scale and a
        consistent appearance beside Create add-ons.
      </p>
      <p>
        <a href="/resourcepacks/reviews">Visual comparisons</a> groups matched
        captures by feature. Create: Skyweave test images and recordings also
        appear beside author thumbnails in each relevant gallery. Captions
        identify the archived test and shader state; they do not establish how
        the current pack renders. The
        <a href="/generated/resource-review/fixture-overview.png">
          earlier Resource Review layout
        </a>
        shows the fixture used for these comparisons.
      </p>
      <p>
        Each of these catalogs contributed 250 listings:{' '}
        {catalog.sources.map((source, i) => (
          <>
            {i > 0 && ' · '}
            <a href={source.url} target="_blank" rel="noreferrer">
              {source.label}
            </a>
          </>
        ))}
        .
      </p>
      <p>
        Broad reskins, Bedrock packs, gameplay datapacks and packs for absent
        mods were screened separately. Selected alternatives outside those
        rankings are included where they answer a concrete compatibility
        question.
      </p>
    </details>
    <p id="pack-empty" hidden>
      No projects match these filters.
    </p>
    <div class="resource-browse">
      <ReviewIndex />
      <div class="resource-reviews">
        <a
          href="#resource-index"
          class="resource-index-back"
          data-resource-index-back
        >
          Back to pack list
        </a>
        <div class="resource-list">
          {reviews.map((review) => (
            <Candidate review={review} />
          ))}
        </div>
      </div>
    </div>
    <details class="catalog-screening">
      <summary>Catalog screening · {catalog.entries.length} listings</summary>
      <Field id="catalog-search" label="Filter listings" layout="inline">
        <input
          id="catalog-search"
          type="search"
          placeholder="Title, source or screening reason"
        />
      </Field>
      <p>
        Listing screening is not an artifact or runtime compatibility test. The
        same project can appear on several sites.
      </p>
      <div class="catalog-scroll">
        <table>
          <thead>
            <tr>
              <th>Source / rank</th>
              <th>Project</th>
              <th>Screening</th>
            </tr>
          </thead>
          <tbody>
            {catalog.entries.map((entry) => (
              <tr
                data-catalog-search={`${entry.source} ${entry.title} ${entry.screen}`.toLowerCase()}
              >
                <td>
                  {entry.source} · {entry.rank}
                </td>
                <td>
                  <a href={entry.url} target="_blank" rel="noreferrer">
                    {entry.title}
                  </a>
                </td>
                <td>
                  {'candidate' in entry && entry.candidate ? (
                    <a href={`#${entry.candidate}`}>
                      Review {projects[entry.candidate]?.title}
                    </a>
                  ) : (
                    entry.screen
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p id="catalog-count" role="status">
        {catalog.entries.length} listings
      </p>
    </details>
  </main>
  <dialog id="image-viewer" aria-label="Resource pack image viewer">
    <div class="viewer-actions">
      <Button type="button" data-previous>
        Previous
      </Button>
      <Button type="button" data-next>
        Next
      </Button>
      <Button type="button" data-close>
        Close
      </Button>
    </div>
    <img alt="" />
    <video
      controls
      playsinline
      preload="none"
      hidden
      aria-label="Test recording"
    ></video>
    <p data-viewer-caption></p>
    <p data-viewer-credit class="gallery-credit"></p>
    <p data-viewer-error hidden>
      Media unavailable. Open the original below.
    </p>
    <a data-original target="_blank" rel="noreferrer">
      Open original ↗
    </a>
  </dialog>
  <script>
    import '../lib/resourcepacks'
  </script>
</Base>
